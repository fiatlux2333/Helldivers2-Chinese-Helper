{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helldivers 2 中文助手",
  "version": "0.5.4",
  "identifier": "io.github.hd2cn.helper",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HD2CN 中文助手",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      },
      {
        "label": "translation-hud",
        "title": "HD2CN 聊天译文",
        "url": "index.html?translation-hud",
        "width": 640,
        "height": 128,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "shadow": false,
        "closable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["必看说明.txt"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
